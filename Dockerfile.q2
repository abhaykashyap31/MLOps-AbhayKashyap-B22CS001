FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    MPLBACKEND=Agg

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# CPU-only stack to stay consistent with the recorded runs/results.
RUN pip install --upgrade pip && \
    pip install --index-url https://download.pytorch.org/whl/cpu \
    torch torchvision && \
    pip install \
    numpy \
    pandas \
    matplotlib \
    "adversarial-robustness-toolbox>=1.18.0" \
    "wandb>=0.17.0"

COPY q2_art_attacks_and_detection.py ./q2_art_attacks_and_detection.py

RUN mkdir -p /app/data /app/q2_outputs

# Pass secrets at runtime instead of baking .env into the image.
# Example:
# docker run --rm -it --env-file .env assignment5-q2
CMD ["python", "q2_art_attacks_and_detection.py", "--no_cuda", "--output_dir", "./q2_outputs"]
